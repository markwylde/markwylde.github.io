  :global(.blog-post:has(.feature) .blog-header){margin-bottom:0;padding-bottom:1.5rem}
  .hero{display:flex;flex-direction:column;justify-content:center;padding:3.25rem 0;position:relative}.section-heading>span{text-transform:uppercase;letter-spacing:.16em;font-size:.68rem;font-weight:700;color:var(--accent-color)}
