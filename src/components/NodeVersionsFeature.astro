  @media(max-width:480px){.hero-actions{align-items:stretch;flex-direction:column}.path-nav,.source-grid{grid-template-columns:1fr}.path-nav a{border-right:0!important;border-bottom:1px solid var(--line)!important}.path-nav a:last-child{border-bottom:0!important}.version-tabs button span{display:none}.risk-list article{grid-template-columns:1fr;gap:.2rem}.migration-order ol{grid-template-columns:1fr 1fr}.recommendation{grid-template-columns:1fr}.rec-node{font-size:4rem}}
