  .choice-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem}.choice-grid button:hover,.choice-grid button.selected{border-color:var(--accent-color);color:var(--ink);background:color-mix(in srgb,var(--accent-color) 9%,var(--soft))}.recommendation{display:grid;grid-template-columns:160px 1fr;gap:2rem;align-items:center;margin-top:1rem;padding:2rem;background:var(--accent-fill);color:white;border-radius:14px}.rec-node{font-size:8rem;font-weight:700;line-height:.8;letter-spacing:-.1em;opacity:.35}.recommendation span{font-size:.68rem;text-transform:uppercase;letter-spacing:.14em}.recommendation h3{color:white;font-size:2rem;margin:.3rem 0}.recommendation p{margin:0;max-width:650px}.caveat{text-align:center;font-size:.72rem;color:var(--muted-color);margin-top:1rem}
