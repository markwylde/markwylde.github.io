---
const versions = [
  {
    id: "22",
    name: "Interoperability",
    status: "LTS",
    v8: "12.4",
    abi: "127",
    pitch: "Node closes much of the gap between CommonJS and ESM.",
    best: "WebSocket, watch mode, globbing, package-script execution and the compile cache all move into Node itself.",
    gains: [
      "require(esm)",
      "WebSocket",
      "stable watch mode",
      "node --run",
      "fs.glob",
      "compile cache",
      "native TS stripping",
    ],
    watch: [
      "Type stripping is not type checking",
      "Top-level await still needs import()",
      "First compile-cache run can be slower",
    ],
  },
  {
    id: "24",
    name: "Consolidation",
    status: "Latest LTS",
    v8: "13.6",
    abi: "137",
    pitch:
      "Node turns the work started in 22 into dependable production features.",
    best: "Type stripping stabilises, URLPattern becomes global, npm reaches version 11 and node:test changes how it waits for subtests.",
    gains: [
      "stable TS stripping",
      "URLPattern",
      "npm 11",
      "RegExp.escape",
      "using",
      "AsyncContextFrame",
      "auto-waiting subtests",
    ],
    watch: [
      "npm 11 can change install behaviour",
      "node:test subtest semantics changed",
      "url.parse() is runtime-deprecated",
    ],
  },
  {
    id: "26",
    name: "Modernisation",
    status: "Current",
    v8: "14.6",
    abi: "147",
    pitch: "Node adds Temporal and removes several compatibility layers.",
    best: "You gain runtime permission drops, Undici 8 and direct SEA builds. You lose bundled Corepack, transform-types and several old APIs.",
    gains: [
      "Temporal",
      "Map upsert",
      "Iterator.concat",
      "permission.drop()",
      "Undici 8",
      "node --build-sea",
      "richer diagnostics",
    ],
    watch: [
      "Not LTS until October 2026",
      "Corepack no longer bundled",
      "transform-types flag and legacy APIs removed",
    ],
  },
];

const capabilities = [
  ["Modules", "Sync require(esm)", "Mature interop", "Loader cleanup"],
  [
    "TypeScript",
    "Stripping introduced",
    "Stripping stable",
    "Erasable syntax only",
  ],
  ["Web platform", "WebSocket", "URLPattern", "Temporal + Undici 8"],
  [
    "Tooling",
    "Watch, --run, glob",
    "npm 11, test semantics",
    "SEA builder, Perfetto",
  ],
  [
    "Security",
    "Stable permissions",
    "Mainstream permission CLI",
    "Runtime permission drop",
  ],
  ["Compatibility", "ABI 127", "ABI 137", "ABI 147 + removals"],
];

const risks = [
  [
    "corepack",
    "CI says corepack: command not found",
    "24 → 26",
    "Install Corepack or your package manager explicitly.",
  ],
  [
    "typescript",
    "Previously accepted .ts syntax fails",
    "24 → 26",
    "Use erasable TypeScript or restore a transpilation step.",
  ],
  [
    "tests",
    "Nested test wrappers behave differently",
    "22 → 24",
    "Remove promise assumptions around t.test() and retest wrappers.",
  ],
  [
    "native",
    "Module version or binary mismatch",
    "Every major",
    "Rebuild direct V8 bindings; prefer Node-API where possible.",
  ],
  [
    "modules",
    "require() fails for an ESM package",
    "All three",
    "If its graph has top-level await, switch the boundary to import().",
  ],
  [
    "legacy",
    "Old URL, TLS, stream or HTTP APIs warn/fail",
    "22 → 24 → 26",
    "Remove deprecated core APIs before changing runtime.",
  ],
  [
    "coverage",
    "Coverage shifts with compile cache enabled",
    "22+",
    "Disable the compile cache for precise coverage runs.",
  ],
  [
    "permissions",
    "A dropped grant leaves an open handle working",
    "26",
    "Close existing handles too; drop() affects future checks only.",
  ],
];
---

<div class="feature" data-feature>
  <header class="hero">
    <h2>What changed while you were building?</h2>
    <p class="dek">Node 22 fixed the module divide. Node 24 made those changes dependable. Node 26 adds new runtime features and removes old compatibility layers.</p>
    <div class="hero-actions">
      <a href="#decision" class="primary">Check your upgrade <span>↓</span></a>
      <a href="/blog/nodejs-22-24-26/map" class="quiet">Explore the map <span>→</span></a>
    </div>
    <div class="signal" aria-label="Upgrade advice">
      <span>Upgrade advice</span>
      <strong>Start new work on the latest LTS. For existing systems, find the concrete blockers, fix them and move forward.</strong>
    </div>
  </header>

  <nav class="path-nav" aria-label="Explore this report">
    <a href="#versions"><small>01</small><span>Compare<br/><b>the releases</b></span></a>
    <a href="#capabilities"><small>02</small><span>Follow<br/><b>a capability</b></span></a>
    <a href="#decision"><small>03</small><span>Assess<br/><b>your upgrade</b></span></a>
    <a href="#migration"><small>04</small><span>Plan<br/><b>the migration</b></span></a>
  </nav>

  <section id="versions" class="feature-section">
    <div class="section-heading"><span>01 / releases</span><h2>See what arrived while you were building</h2><p>Select a release to see what it added and what you need to test.</p></div>
    <div class="version-tabs" role="tablist" aria-label="Node.js versions">
      {versions.map((v, i) => <button type="button" role="tab" aria-selected={i === 1 ? "true" : "false"} data-version={v.id}><b>Node {v.id}</b><span>{v.name}</span></button>)}
    </div>
    <div class="version-stage">
      {versions.map((v) => <article class:list={["version-panel", { active: v.id === "24" }]} data-panel={v.id}>
        <div class="version-number">{v.id}</div>
        <div class="version-copy">
          <div class="status"><span>{v.status}</span> V8 {v.v8} · ABI {v.abi}</div>
          <h3>{v.pitch}</h3><p>{v.best}</p>
          <div class="two-col"><div><h4>What arrives</h4><ul class="chip-list">{v.gains.map(x => <li>{x}</li>)}</ul></div><div><h4>What to test</h4><ul class="watch-list">{v.watch.map(x => <li>{x}</li>)}</ul></div></div>
        </div>
      </article>)}
    </div>
    <details class="deep"><summary><span>Details</span> Release summary</summary><div><p><b>Node 22 focuses on interoperability.</b> It adds browser-style WebSocket, stable watch mode, first-party globbing and package-script execution. The bigger change is synchronous <code>require()</code> of eligible ESM. Later 22.x releases add native TypeScript stripping and persistent module compile caching.</p><p><b>Node 24 consolidates that work.</b> V8 13.6, npm 11, global <code>URLPattern</code>, a faster async-context implementation and changed test semantics make it a practical production baseline. Type stripping becomes stable in 24.12.</p><p><b>Node 26 removes more old behavior.</b> It adds Temporal, collection APIs, runtime permission drops, Undici 8 and direct SEA construction. It also removes Corepack and several legacy APIs.</p></div></details>
  </section>

  <section id="capabilities" class="feature-section shaded">
    <div class="section-heading"><span>02 / capabilities</span><h2>Follow the changes you care about</h2><p>Track modules, TypeScript, tooling, security or compatibility across all three releases.</p></div>
    <div class="cap-grid" role="table" aria-label="Capability comparison">
      <div class="cap-row cap-head" role="row"><b>Concern</b><span>Node 22</span><span>Node 24</span><span>Node 26</span></div>
      {capabilities.map(row => <div class="cap-row" role="row"><b>{row[0]}</b><span>{row[1]}</span><span>{row[2]}</span><span>{row[3]}</span></div>)}
    </div>
    <details class="deep"><summary><span>Details</span> What native TypeScript supports</summary><div><div class="progression"><i>22.6<br/><b>introduced</b></i><i>22.18<br/><b>default</b></i><i>24.12<br/><b>stable</b></i><i>26<br/><b>stripping only</b></i></div><p>Node removes erasable type syntax. It does not type-check, read <code>tsconfig.json</code>, honour path aliases, down-level code, or generate JavaScript for TypeScript-only constructs. Run code with <code>node src/app.ts</code> and validate it separately with <code>tsc --noEmit</code>.</p></div></details>
    <details class="deep"><summary><span>Details</span> What to benchmark</summary><div><p>No single performance percentage applies to every application. Node 22 adds Maglev and a persistent compile cache. Node 24 moves <code>AsyncLocalStorage</code> to AsyncContextFrame. Node 26 changes V8, Undici, Buffer pooling and diagnostics. Measure startup time, steady-state latency, throughput, memory, garbage collection and production-level concurrency.</p></div></details>
  </section>

  <section id="decision" class="feature-section decision">
    <div class="section-heading"><span>03 / readiness</span><h2>What could complicate your upgrade?</h2><p>Pick the description closest to your codebase. We will show you what to check before changing the runtime.</p></div>
    <div class="choice-grid" role="group" aria-label="Upgrade risk profile">
      <button type="button" data-choice="plain">Mostly JavaScript and public Node APIs</button><button type="button" data-choice="native">Native addons or binary dependencies</button><button type="button" data-choice="typescript">Native TypeScript or custom ESM loaders</button><button type="button" data-choice="tooling">Corepack, nested node:test, or older core APIs</button>
    </div>
    <div class="recommendation" aria-live="polite"><div class="rec-node">GO</div><div><span>Likely upgrade effort</span><h3>Start with a dual-runtime test</h3><p>Run the full suite on your current runtime and the target. Then test module boundaries, HTTP behavior and production-level workloads.</p></div></div>
    <p class="caveat">An older version is a starting point for the assessment, not a recommendation to stay there.</p>
  </section>

  <section id="migration" class="feature-section">
    <div class="section-heading"><span>04 / migration</span><h2>Find the traps before they find CI</h2><p>Search by symptom, version boundary, or topic.</p></div>
    <label class="risk-search"><span>⌕</span><input type="search" placeholder="Try “Corepack”, “TypeScript”, or “native”…" aria-label="Filter migration risks" data-risk-search /></label>
    <div class="risk-list">
      {risks.map(r => <article data-risk={`${r[0]} ${r[1]} ${r[2]} ${r[3]}`.toLowerCase()}><div class="risk-route">{r[2]}</div><div><h3>{r[1]}</h3><p>{r[3]}</p></div></article>)}
    </div>
    <div class="migration-order"><span>Recommended order</span><ol><li>Update dependencies on the old runtime</li><li>Remove runtime deprecations</li><li>Audit native addons</li><li>Test both runtimes</li><li>Exercise module and CI edges</li><li>Benchmark the real workload</li></ol></div>
  </section>

  <section class="feature-section sources">
    <div class="section-heading"><span>Evidence</span><h2>Go to the source</h2><p>Check the claims against the Node.js release notes and documentation.</p></div>
    <div class="source-grid"><a href="https://nodejs.org/en/blog/release/v22.0.0">Node 22 release notes <span>↗</span></a><a href="https://nodejs.org/en/blog/release/v24.0.0">Node 24 release notes <span>↗</span></a><a href="https://nodejs.org/en/blog/release/v26.0.0">Node 26 release notes <span>↗</span></a><a href="https://nodejs.org/en/about/previous-releases">Release status <span>↗</span></a><a href="https://nodejs.org/api/typescript.html">TypeScript in Node <span>↗</span></a><a href="https://nodejs.org/api/permissions.html">Permission model <span>↗</span></a></div>
    <details class="deep"><summary><span>Method</span> Introduction date vs current capability</summary><div><p>This feature compares even-numbered production generations: 22 against 20, 24 against 22, and 26 against 24. It distinguishes features in each <code>.0.0</code> release from capabilities later backported or stabilised within that line. That is why TypeScript appears across all three: introduced in 22.6, default in 22.18, stable in 24.12.</p></div></details>
  </section>
</div>

<script>
  const root = document.querySelector('[data-feature]');
  if (root) {
    const tabs = [...root.querySelectorAll('[data-version]')];
    const panels = [...root.querySelectorAll('[data-panel]')];
    tabs.forEach(tab => tab.addEventListener('click', () => { tabs.forEach(t => t.setAttribute('aria-selected', String(t === tab))); panels.forEach(p => p.classList.toggle('active', p.dataset.panel === tab.dataset.version)); }));
    const recs = {
      plain: ['GO','Start with the test suite','Run the complete suite on both runtimes, check ESM/CJS boundaries and benchmark the real workload. If those checks pass, upgrade.'],
      native: ['ABI','Audit binaries first','The native module ABI changes 127 → 137 → 147. Identify Node-API dependencies, then verify that direct V8 or Node C++ addons have builds for your target.'],
      typescript: ['TS','Review the execution model','Node strips erasable types; it does not type-check or honour tsconfig paths. For 26, remove transform-types assumptions and review custom module.register() loaders.'],
      tooling: ['CI','Expect a tooling pass','For 22 → 24, inspect nested node:test wrappers and npm 11 behavior. For 24 → 26, provision Corepack explicitly and remove APIs Node 26 deleted.']
    };
    const rec = root.querySelector('.recommendation');
    root.querySelectorAll('[data-choice]').forEach(btn => btn.addEventListener('click', () => { root.querySelectorAll('[data-choice]').forEach(b => b.classList.toggle('selected', b === btn)); const [n,h,p] = recs[btn.dataset.choice]; rec.querySelector('.rec-node').textContent=n; rec.querySelector('h3').textContent=h; rec.querySelector('p').textContent=p; }));
    const search = root.querySelector('[data-risk-search]');
    search?.addEventListener('input', () => root.querySelectorAll('[data-risk]').forEach(item => item.toggleAttribute('hidden', !item.dataset.risk.includes(search.value.toLowerCase()))));
  }
</script>

