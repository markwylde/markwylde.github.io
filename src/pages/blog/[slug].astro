---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import "../../styles/demos.css";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} - Mark Wylde`} currentPage="blog">
	<section class="section">
		<div class="container">
			<div class="content-panel blog-article-panel">
				<article class="blog-post">
					<header class="blog-header">
					<h1>{entry.data.title}</h1>
					<div class="blog-meta">
						<time datetime={entry.data.date}>
							{new Date(entry.data.date).toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'long',
								day: 'numeric'
							})}
						</time>
						<div class="blog-tags">
							{entry.data.tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</div>
					</div>
				</header>
				<div class="blog-content">
					<Content />
				</div>
				<footer class="blog-footer">
					<a href="/blog" class="back-link">← Back to Blog</a>
				</footer>
				</article>
			</div>
		</div>
	</section>
</Layout>

<style>
	.blog-article-panel {
		max-width: 1400px;
		margin: 0 auto;
	}

	.blog-post {
		margin: 0 auto;
	}

	.blog-header {
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--border-color);
	}

	.blog-header h1 {
		margin-bottom: 1rem;
		color: var(--heading-color);
	}

	.blog-meta {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 10px;
	}

	.blog-content {
		line-height: 1.7;
		margin-bottom: 3rem;
	}

	.blog-content :global(h1),
	.blog-content :global(h2),
	.blog-content :global(h3),
	.blog-content :global(h4),
	.blog-content :global(h5),
	.blog-content :global(h6) {
		color: var(--heading-color);
		margin-top: 2rem;
		margin-bottom: 1rem;
	}

	.blog-content :global(h1) {
		font-size: 2rem;
	}

	.blog-content :global(h2) {
		font-size: 1.5rem;
	}

	.blog-content :global(h3) {
		font-size: 1.25rem;
	}

	.blog-content :global(p) {
		margin-bottom: 1rem;
	}

	.blog-content :global(code) {
		background-color: var(--surface-2);
		padding: 2px 4px;
		border-radius: 3px;
		font-family: 'Courier New', monospace;
		font-size: 0.9rem;
		border: 1px solid var(--border-color);
	}

	.blog-content :global(pre) {
		background-color: var(--surface-2);
		padding: 1rem;
		border-radius: 8px;
		overflow-x: auto;
		margin: 1rem 0;
		border: 1px solid var(--border-color);
	}

	.blog-content :global(pre code) {
		background: none;
		padding: 0;
		border: none;
	}

	.blog-content :global(blockquote) {
		border-left: 4px solid var(--accent-color);
		padding-left: 1rem;
		margin: 1rem 0;
		font-style: italic;
		color: var(--accent-color);
	}

	.blog-content :global(ul),
	.blog-content :global(ol) {
		padding-left: 1.5rem;
		margin-bottom: 1rem;
	}

	.blog-content :global(li) {
		margin-bottom: 0.5rem;
	}

	.blog-content :global(a) {
		color: var(--accent-color);
		text-decoration: none;
	}

	.blog-content :global(a:hover) {
		text-decoration: underline;
	}

	.blog-content :global(img) {
		width: 100%;
		height: auto;
		border-radius: 8px;
		margin: 1.5rem 0;
	}

	.blog-content :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 1.5rem 0;
		display: block;
		overflow-x: auto;
	}

	.blog-content :global(th),
	.blog-content :global(td) {
		padding: 0.6rem 0.9rem;
		border: 1px solid var(--border-color);
		text-align: left;
		vertical-align: top;
	}

	.blog-content :global(th) {
		background-color: var(--surface-2);
		color: var(--heading-color);
		font-weight: 600;
	}

	.blog-content :global(tbody tr:nth-child(even)) {
		background-color: var(--surface-2);
	}

	.blog-footer {
		padding-top: 2rem;
		border-top: 1px solid var(--border-color);
	}

	.back-link {
		color: var(--accent-color);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.3s ease;
	}

	.back-link:hover {
		color: var(--heading-color);
	}

	/* full-bleed band for the small inline demos: background spans the
	   content card, inner content stays aligned with the text column */
	.blog-content :global(.demo-band) {
		margin: 1.75rem -3rem;
		padding: 1.5rem 3rem;
		background-color: var(--surface-2);
		border-top: 1px solid var(--border-color);
		border-bottom: 1px solid var(--border-color);
	}

	/* jump nav: quick anchors to skip straight to a section */
	.blog-content :global(.jump-nav) {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 1.5rem 0 2.5rem;
		padding: 0;
		list-style: none;
	}

	.blog-content :global(.jump-nav a) {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--text-color);
		background-color: var(--surface-2);
		border: 1px solid var(--border-color);
		border-radius: 999px;
		padding: 6px 14px;
		text-decoration: none;
		transition: all 0.15s ease;
	}

	.blog-content :global(.jump-nav a:hover) {
		border-color: var(--accent-color);
		color: var(--accent-color);
		text-decoration: none;
	}

	.blog-content :global(.jump-nav .n) {
		color: var(--muted-color);
		font-variant-numeric: tabular-nums;
	}

	/* self-contained card around each interactive tool: heading + short
	   lead + the widget, so it reads as one distinct chunk, not more prose */
	.blog-content :global(.tool-section) {
		background-color: var(--surface-2);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		padding: 0.5rem 1.75rem 1.75rem;
		margin: 2.5rem 0;
	}

	.blog-content :global(.tool-section h2) {
		margin-top: 1.5rem;
	}

	.blog-content :global(.tool-section > p) {
		color: var(--muted-color);
		margin-bottom: 1.25rem;
	}

	.blog-content :global(.tool-kicker) {
		display: block;
		font-size: 0.76rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--accent-color);
		margin-top: 1.5rem;
	}

	.blog-content :global(.tool-section .tool-kicker) {
		margin-top: 0;
		padding-top: 1.5rem;
	}

	/* collapsible deep-dive sections: styled like clickable cards instead
	   of the bare browser default, so "drill down" reads as an action */
	.blog-content :global(details) {
		border: 1px solid var(--border-color);
		border-radius: 10px;
		margin: 0.75rem 0;
		background-color: var(--secondary-bg);
		overflow: hidden;
	}

	.blog-content :global(details > summary) {
		cursor: pointer;
		list-style: none;
		padding: 1rem 1.25rem;
		font-weight: 600;
		color: var(--heading-color);
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.blog-content :global(details > summary::-webkit-details-marker) {
		display: none;
	}

	.blog-content :global(details > summary::before) {
		content: "▸";
		display: inline-block;
		color: var(--accent-color);
		transition: transform 0.15s ease;
		flex-shrink: 0;
	}

	.blog-content :global(details[open] > summary::before) {
		transform: rotate(90deg);
	}

	.blog-content :global(details > summary:hover) {
		background-color: var(--primary-bg);
	}

	.blog-content :global(details > *:not(summary)) {
		padding: 0 1.25rem;
	}

	.blog-content :global(details > *:last-child) {
		padding-bottom: 1.25rem;
	}

	.blog-content :global(details > summary ~ p:first-of-type) {
		margin-top: 0;
	}

	@media (max-width: 768px) {
		.blog-content :global(.demo-band) {
			margin-left: -1rem;
			margin-right: -1rem;
			padding-left: 1rem;
			padding-right: 1rem;
		}

		.blog-content :global(.tool-section) {
			padding: 0.5rem 1rem 1rem;
			margin: 1.75rem 0;
		}

		.blog-content :global(.jump-nav) {
			gap: 6px;
			margin: 1.25rem 0 2rem;
		}

		.blog-content :global(.jump-nav a) {
			font-size: 0.78rem;
			padding: 5px 11px;
		}

		.blog-header {
			margin-bottom: 1rem;
		}

		.blog-header h1 {
			line-height: 1.2;
			margin-bottom: 0.5rem;
		}

		.blog-meta {
			flex-direction: column;
			align-items: flex-start;
		}

		.blog-content {
			margin-bottom: 1.5rem;
		}
	}
</style>
