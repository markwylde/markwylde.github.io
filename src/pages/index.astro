---
import { getCollection } from "astro:content";
import avatarImage from "../assets/avatar-typing-transparent.png";
import allianzDarkLogo from "../assets/logos/allianz-dark.png";
import allianzLightLogo from "../assets/logos/allianz-light.svg";
import aucloudDarkLogo from "../assets/logos/aucloud-dark.png";
import aucloudLightLogo from "../assets/logos/aucloud-light.png";
import checkatradeDarkLogo from "../assets/logos/checkatrade-dark.svg";
import checkatradeLightLogo from "../assets/logos/checkatrade-light.svg";
import legal500DarkLogo from "../assets/logos/legal500-dark.svg";
import legal500LightLogo from "../assets/logos/legal500-light.svg";
import rbsDarkLogo from "../assets/logos/rbs-dark.svg";
import rbsLightLogo from "../assets/logos/rbs-light.svg";
import darkAuthLogo from "../assets/projects/darkauth.svg";
import pagedNetLogo from "../assets/projects/pagednet.svg";
import terminayLogo from "../assets/projects/terminay.svg";
import wrapGuardLogo from "../assets/projects/wrapguard.svg";
import Layout from "../layouts/Layout.astro";

const careerClients = [
  {
    name: "RBS",
    lightLogo: rbsLightLogo,
    darkLogo: rbsDarkLogo,
    className: "client-logo-rbs",
  },
  {
    name: "Allianz",
    lightLogo: allianzLightLogo,
    darkLogo: allianzDarkLogo,
    className: "client-logo-allianz",
  },
  {
    name: "AUCloud",
    lightLogo: aucloudLightLogo,
    darkLogo: aucloudDarkLogo,
    className: "client-logo-aucloud",
  },
  {
    name: "Checkatrade",
    lightLogo: checkatradeLightLogo,
    darkLogo: checkatradeDarkLogo,
    className: "client-logo-checkatrade",
  },
  {
    name: "Legal 500",
    lightLogo: legal500LightLogo,
    darkLogo: legal500DarkLogo,
    className: "client-logo-legal500",
  },
];

const personalProjects = [
  {
    name: "Terminay",
    description:
      "A desktop terminal workspace built with Electron, React, and Vite.",
    href: "https://github.com/markwylde/terminay",
    logo: terminayLogo,
  },
  {
    name: "DarkAuth",
    description: "Zero-knowledge authentication with OIDC compatibility.",
    href: "https://github.com/puzed/darkauth",
    logo: darkAuthLogo,
  },
  {
    name: "WrapGuard",
    description:
      "Userspace WireGuard proxy for routing app traffic without kernel modules.",
    href: "https://github.com/puzed/wrapguard",
    logo: wrapGuardLogo,
  },
  {
    name: "PagedNet",
    description:
      "Static-site hosting for uploading, managing, and moderating deployed sites.",
    href: "https://paged.net",
    logo: pagedNetLogo,
  },
];
const howIWork = [
  {
    title: "AI-assisted development",
    text: "Using AI tools to ship faster and smarter.",
  },
  {
    title: "Continuous deployments",
    text: "Shipping iteratively with confidence.",
  },
  {
    title: "Product driven development",
    text: "Solving real problems for real people.",
  },
];

const allPosts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const recentPosts = allPosts.slice(0, 4);

const formatDate = (date) =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<Layout
	title="Mark Wylde - Personal Portfolio"
	currentPage="home"
	preloadImages={[avatarImage]}
>
	<div class="container home">
		<header class="tile hero">
			<div class="hero-copy">
				<p class="eyebrow">Software engineer · 15+ years on the web</p>
				<h1>Hi, I'm Mark Wylde.</h1>
				<p class="lede">I build useful, reliable products with modern web tech.</p>
				<p class="intro">
					I've built my reputation pulling teams out of technical rabbit holes and focusing them on
					delivering products through continuous iteration.
				</p>
				<ul class="tech-tags">
					<li>TypeScript</li>
					<li>Node.js</li>
					<li>React</li>
					<li>Postgres</li>
					<li>CI/CD</li>
					<li>AI</li>
				</ul>
				<div class="pill-links">
					<a class="pill pill-primary" href="mailto:mark@wylde.net">Email me</a>
					<a class="pill" href="https://github.com/markwylde" target="_blank" rel="noreferrer">GitHub</a>
					<a class="pill" href="https://linkedin.com/in/mwylde" target="_blank" rel="noreferrer">LinkedIn</a>
				</div>
			</div>
			<div class="hero-art">
				<img
					src={avatarImage.src}
					width={avatarImage.width}
					height={avatarImage.height}
					alt="Cartoon of Mark typing on a laptop"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
			</div>
		</header>

		<ul class="tile client-grid" aria-label="Career clients">
			{careerClients.map((client) => (
				<li class={`client-logo ${client.className ?? ""}`} role="img" aria-label={client.name}>
					<img
						src={client.lightLogo.src}
						alt=""
						class="client-logo-image client-logo-image-light"
						loading="lazy"
					/>
					<img
						src={client.darkLogo.src}
						alt=""
						class="client-logo-image client-logo-image-dark"
						loading="lazy"
					/>
				</li>
			))}
		</ul>

		<ul class="how-grid" aria-label="How I work">
			{howIWork.map((item) => (
				<li class="tile how-tile">
					<h2>{item.title}</h2>
					<p>{item.text}</p>
				</li>
			))}
		</ul>

		<section id="projects" class="tile projects">
			<h2 class="tile-heading">Personal projects</h2>
			<ul class="project-grid">
				{personalProjects.map((project) => (
					<li>
						<a class="project-tile" href={project.href} target="_blank" rel="noreferrer">
							<img src={project.logo.src} alt="" class="project-logo" loading="lazy" />
							<span class="project-text">
								<strong>{project.name}</strong>
								<span>{project.description}</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<section id="writing" class="tile writing">
			<h2 class="tile-heading">Recent writing</h2>
			<ul class="post-rows">
				{recentPosts.map((post) => (
					<li class="post-row">
						<a href={`/blog/${post.id}`}>
							<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
							<span class="post-row-title">{post.data.title}</span>
						</a>
					</li>
				))}
			</ul>
			<a class="more-link" href="/blog">All {allPosts.length} posts →</a>
		</section>

		<section id="contact" class="tile contact">
			<div class="contact-copy">
				<h2>Get in touch</h2>
				<p>
					I'm always open to discussing new projects, creative ideas, or opportunities to be part of
					something great.
				</p>
			</div>
			<div class="contact-actions">
				<a class="contact-email" href="mailto:mark@wylde.net">mark@wylde.net</a>
				<div class="pill-links">
					<a class="pill" href="https://github.com/markwylde" target="_blank" rel="noreferrer">GitHub</a>
					<a class="pill" href="https://linkedin.com/in/mwylde" target="_blank" rel="noreferrer">LinkedIn</a>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	/* The home page is one 12-column grid of tiles inside the shared container. */
	.home {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: var(--gap);
		margin-top: var(--gap);
	}

	.home > * {
		grid-column: span 12;
	}

	.tile {
		background-color: var(--secondary-bg);
		border-radius: var(--radius);
		padding: var(--pad);
	}

	ul {
		list-style: none;
	}

	.tile-heading {
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: 0;
		margin-bottom: 1.1rem;
	}

	/* Hero: copy on the left, illustration on a disc sized to the figure. */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) clamp(13rem, 30vw, 23rem);
		gap: 0 1rem;
		padding: 0;
		overflow: hidden;
	}

	.hero-copy {
		display: grid;
		gap: 1rem;
		justify-items: start;
		align-content: center;
		padding: var(--pad);
	}

	.hero-copy > * {
		margin: 0;
	}

	.eyebrow {
		font-weight: 600;
		font-size: 0.85rem;
		color: var(--muted-color);
	}

	.hero h1 {
		font-size: clamp(2rem, 5.5vw, 3.4rem);
		letter-spacing: -0.035em;
		line-height: 1.05;
	}

	.lede {
		font-size: 1.2rem;
		font-weight: 500;
		line-height: 1.4;
		color: var(--heading-color);
	}

	.tech-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tech-tags li {
		background-color: var(--surface-2);
		border-radius: 999px;
		padding: 0.2rem 0.7rem;
		font-size: 0.82rem;
		font-weight: 600;
	}

	.hero-art {
		position: relative;
		align-self: end;
		margin-right: var(--pad);
		padding-top: var(--pad);
	}

	.hero-art::before {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		top: 16%;
		aspect-ratio: 1;
		border-radius: 50%;
		background-color: var(--avatar-bg);
	}

	.hero-art img {
		position: relative;
		display: block;
		width: 100%;
		height: auto;
	}

	/* Client logos: just the logos, spread across the tile. */
	.client-grid {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-around;
		gap: 1.25rem 2.5rem;
	}

	.client-logo {
		--client-logo-width: 178px;
		--client-logo-height: 52px;
		display: grid;
		place-items: center;
	}

	.client-logo-image {
		grid-area: 1 / 1;
		display: block;
		width: var(--client-logo-width);
		max-width: 100%;
		height: var(--client-logo-height);
		object-fit: contain;
		filter: grayscale(100%) opacity(0.7);
	}

	.client-logo-rbs {
		--client-logo-width: 118px;
		--client-logo-height: 34px;
	}

	.client-logo-allianz {
		--client-logo-width: 152px;
		--client-logo-height: 44px;
	}

	.client-logo-aucloud {
		--client-logo-width: 174px;
		--client-logo-height: 46px;
	}

	.client-logo-checkatrade {
		--client-logo-width: 180px;
		--client-logo-height: 42px;
	}

	.client-logo-legal500 {
		--client-logo-width: 166px;
		--client-logo-height: 46px;
	}

	/* Exactly one logo per client is ever rendered: light by default, dark
	   when the site theme is dark. */
	.client-logo-image-dark {
		display: none;
	}

	:global([data-theme="dark"]) .client-logo-image-light {
		display: none;
	}

	:global([data-theme="dark"]) .client-logo-image-dark {
		display: block;
	}

	/* How I work: three equal tiles. */
	.how-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--gap);
	}

	.how-tile {
		padding-block: 1.5rem;
	}

	.how-tile h2 {
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0;
		margin-bottom: 0.15rem;
	}

	.how-tile p {
		color: var(--muted-color);
		font-size: 0.95rem;
		line-height: 1.5;
		margin: 0;
	}

	.home > .projects {
		grid-column: span 7;
	}

	.home > .writing {
		grid-column: span 5;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.project-tile {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
		height: 100%;
		background-color: var(--surface-2);
		border-radius: var(--radius-inner);
		padding: 1rem;
		color: inherit;
		transition: background-color 0.2s ease;
	}

	.project-tile:hover {
		background-color: var(--accent-soft);
		color: inherit;
	}

	.project-logo {
		width: 2.25rem;
		height: 2.25rem;
		object-fit: contain;
	}

	.project-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.project-text strong {
		font-weight: 700;
		color: var(--heading-color);
	}

	.project-text span {
		color: var(--muted-color);
		font-size: 0.95rem;
		line-height: 1.45;
	}

	.writing .post-row a {
		grid-template-columns: 1fr;
	}

	.more-link {
		display: inline-block;
		margin-top: 1rem;
		font-weight: 700;
	}

	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1.25rem 3rem;
		align-items: center;
		background-color: var(--accent-fill);
		color: var(--on-accent);
	}

	.contact h2 {
		color: inherit;
		margin-bottom: 0.5rem;
	}

	.contact p {
		max-width: 34rem;
		margin: 0;
	}

	.contact-actions {
		display: grid;
		gap: 0.85rem;
	}

	.contact-email {
		color: inherit;
		font-size: 1.4rem;
		font-weight: 800;
		text-decoration: underline;
		text-underline-offset: 5px;
	}

	.contact-email:hover {
		color: inherit;
		text-decoration-thickness: 2px;
	}

	.contact .pill,
	.contact .pill:hover {
		background: none;
		color: inherit;
		box-shadow: inset 0 0 0 1.5px currentColor;
	}

	@media (max-width: 860px) {
		.home > .projects,
		.home > .writing {
			grid-column: span 12;
		}

		.how-grid {
			grid-template-columns: 1fr;
		}

		.contact {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.hero-art {
			width: 15rem;
			justify-self: end;
			padding-top: 0;
			margin-top: -1rem;
		}

		.client-grid {
			justify-content: flex-start;
		}

		.client-logo {
			zoom: 0.8;
		}
	}

	@media (max-width: 560px) {
		.project-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
