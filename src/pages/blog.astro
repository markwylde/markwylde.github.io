---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const blogPosts = await getCollection("blog");
const getPostSlug = (post) => post.id;
const sortedPosts = blogPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Group posts by year
const postsByYear = sortedPosts.reduce((acc, post) => {
  const year = new Date(post.data.date).getFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {});
const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));

const formatDate = (date) =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<Layout title="Blog - Mark Wylde" currentPage="blog">
  <section class="section">
    <div class="container">
      <div class="content-panel">
        <header class="page-header">
          <h1>Blog</h1>
          <p>Thoughts on web development, simplicity, and building things that work</p>
        </header>

        {
          years.map((year) => (
            <section class="year-section">
              <h2 class="year-heading">{year}</h2>
              <ul class="post-rows">
                {postsByYear[year].map((post) => {
                  const postDate = new Date(post.data.date);
                  return (
                    <li class="post-row">
                      <a href={`/blog/${getPostSlug(post)}`}>
                        <time datetime={postDate.toISOString()}>{formatDate(postDate)}</time>
                        <span>
                          <span class="post-row-title">{post.data.title}</span>
                          <span class="post-row-excerpt">{post.data.excerpt}</span>
                          {post.data.tags.length > 0 && (
                            <span class="blog-tags">
                              {post.data.tags.map((tag) => (
                                <span class="tag">{tag}</span>
                              ))}
                            </span>
                          )}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .year-section + .year-section {
    margin-top: 2rem;
  }

  .year-heading {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0;
    margin-bottom: 0.75rem;
  }
</style>
