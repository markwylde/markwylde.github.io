---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const blogPosts = await getCollection("blog");
const getPostSlug = (post) => post.id;
const sortedPosts = blogPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Group posts by month
const postsByMonth = sortedPosts.reduce((acc, post) => {
  const date = new Date(post.data.date);
  const monthYear = date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
  });
  if (!acc[monthYear]) {
    acc[monthYear] = [];
  }
  acc[monthYear].push(post);
  return acc;
}, {});

const formatDay = (date) =>
  date.toLocaleDateString("en-US", { day: "numeric" });

const formatWeekday = (date) =>
  date.toLocaleDateString("en-US", { weekday: "short" });
---

<Layout title="Blog - Mark Wylde" currentPage="blog">
  <section class="section">
    <div class="container">
      <div class="blog-header">
        <h1>Blog</h1>
        <p>Thoughts on web development, simplicity, and building things that work</p>
      </div>

      <div class="blog-list">
        {
          Object.entries(postsByMonth).map(([monthYear, posts]) => (
            <section class="month-section">
              <h2 class="month-heading">{monthYear}</h2>
              <ul class="posts-list">
                {posts.map((post) => {
                  const postDate = new Date(post.data.date);
                  return (
                    <li class="post-item">
                      <a href={`/blog/${getPostSlug(post)}`} class="post-link">
                        <span class="post-date">
                          <span class="post-day">{formatDay(postDate)}</span>
                          <span class="post-weekday">
                            {formatWeekday(postDate)}
                          </span>
                        </span>
                        <span class="post-content">
                          <span class="post-title">{post.data.title}</span>
                          <span class="post-excerpt">{post.data.excerpt}</span>
                          {post.data.tags.length > 0 && (
                            <span class="post-tags">
                              {post.data.tags.map((tag) => (
                                <span class="tag">{tag}</span>
                              ))}
                            </span>
                          )}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .blog-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--heading-color);
  }

  .blog-header p {
    font-size: 1.1rem;
    color: var(--muted-color);
    margin-bottom: 0;
  }

  .blog-list {
    max-width: 880px;
    margin: 0 auto;
  }

  .month-section {
    margin-bottom: 3.5rem;
  }

  .month-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--heading-color);
    margin-bottom: 0;
    padding: 0 0 0.75rem 5.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .posts-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    border-bottom: 1px solid var(--border-color);
  }

  .post-link {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.25rem 0;
    text-decoration: none;
    color: inherit;
    border-radius: 6px;
    transition: background-color 0.2s ease;
  }

  .post-link:hover {
    background-color: var(--secondary-bg);
  }

  .post-link:hover .post-title {
    color: var(--accent-color);
  }

  .post-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-width: 4rem;
    padding-top: 0.25rem;
    color: var(--muted-color);
    text-align: center;
  }

  .post-day {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--heading-color);
  }

  .post-weekday {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  .post-content {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
  }

  .post-title {
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--heading-color);
    transition: color 0.2s ease;
  }

  .post-excerpt {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.9;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  @media (max-width: 640px) {
    .blog-header {
      margin-bottom: 2.5rem;
    }

    .month-heading {
      padding-left: 0;
    }

    .post-link {
      gap: 1rem;
      padding: 1rem 0;
    }

    .post-date {
      min-width: 2.75rem;
      padding-top: 0.15rem;
    }

    .post-day {
      font-size: 1.15rem;
    }

    .post-weekday {
      font-size: 0.65rem;
    }

    .post-title {
      font-size: 1.05rem;
    }

    .post-excerpt {
      font-size: 0.9rem;
      line-height: 1.5;
    }
  }
</style>
