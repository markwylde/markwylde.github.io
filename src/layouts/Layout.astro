---
import avatarHeaderFallback from "../assets/avatar-portrait.png";
import avatarVideoMp4 from "../assets/avatar-portrait-140.mp4";
import ThemeToggle from "../components/ThemeToggle.tsx";
export interface Props {
  title?: string;
  currentPage?: string;
  preloadImages?: Array<{ src: string }>;
}

const {
  title = "Mark Wylde - Personal Portfolio",
  currentPage = "home",
  preloadImages = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{preloadImages.map((image) => <link rel="preload" as="image" href={image.src} />)}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&display=swap" rel="stylesheet">
		<script is:inline>
			(function() {
				const savedTheme = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const theme = savedTheme || (prefersDark ? 'dark' : 'light');
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<body>
		<div class="site-header">
			<div class="container">
				<div class="site-header-content">
					<a href="/" class="header-brand">
						<video autoplay muted class="header-avatar" playsinline poster={avatarHeaderFallback.src} width="36" height="36">
							<source src={avatarVideoMp4} type="video/mp4" />
							<img src={avatarHeaderFallback.src} alt="Mark Wylde - Avatar" />
						</video>
						<span class="header-site-title">Mark Wylde</span>
					</a>
					<nav class="main-nav" aria-label="Site">
						<a href="/" class={`nav-link ${currentPage === 'home' ? 'nav-link-active' : ''}`}>Home</a>
						<a href="/about" class={`nav-link ${currentPage === 'about' ? 'nav-link-active' : ''}`}>About</a>
						<a href="/blog" class={`nav-link ${currentPage === 'blog' ? 'nav-link-active' : ''}`}>Blog</a>
						<a href="/research" class={`nav-link ${currentPage === 'research' ? 'nav-link-active' : ''}`}>Research</a>
					</nav>
					<ThemeToggle client:load />
				</div>
			</div>
		</div>
		<main>
			<slot />
		</main>
		<footer class="footer">
			<div class="container">
				<p>&copy; <span id="currentYear"></span> Mark Wylde</p>
			</div>
		</footer>
		<script>
			const currentYearElement = document.getElementById('currentYear');
			if (currentYearElement) {
				currentYearElement.textContent = new Date().getFullYear().toString();
			}

			const siteHeader = document.querySelector('.site-header');
			const headerAvatar = document.querySelector('.header-avatar');

			if (siteHeader && headerAvatar) {
				let currentTimeUpdateListener = null;

				function playToMidpoint() {
					// Remove any existing listener to prevent conflicts
					if (currentTimeUpdateListener) {
						headerAvatar.removeEventListener('timeupdate', currentTimeUpdateListener);
					}

					headerAvatar.currentTime = 0;
					headerAvatar.play();

					currentTimeUpdateListener = () => {
						if (headerAvatar.currentTime >= headerAvatar.duration * 0.5) {
							headerAvatar.pause();
							headerAvatar.removeEventListener('timeupdate', currentTimeUpdateListener);
							currentTimeUpdateListener = null;
						}
					};

					headerAvatar.addEventListener('timeupdate', currentTimeUpdateListener);
				}

				function playFromMidpoint() {
					// Remove any existing listener to prevent interference
					if (currentTimeUpdateListener) {
						headerAvatar.removeEventListener('timeupdate', currentTimeUpdateListener);
						currentTimeUpdateListener = null;
					}

					headerAvatar.currentTime = headerAvatar.duration * 0.5;
					headerAvatar.play();
				}

				siteHeader.addEventListener('mouseenter', playToMidpoint);
				siteHeader.addEventListener('mouseleave', playFromMidpoint);
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--primary-bg: #eceef2;      /* page */
		--secondary-bg: #ffffff;    /* tiles, header */
		--surface-2: #f2f4f7;       /* inner tiles, code, chips — recessed inside a tile */
		--text-color: #454b59;
		--heading-color: #10131a;
		--muted-color: #6b7282;
		--accent-color: #0b6bcb;
		--accent-fill: #0b6bcb;
		--accent-fill-hover: #0959a8;
		--accent-soft: #dcebfa;
		--on-accent: #ffffff;
		--header-bg: #ffffff;
		--border-color: #e3e6ec;
		--shadow-color: rgba(16, 19, 26, 0.06);
		--hero-bg: #eceef2;
		--avatar-bg: #dcebfa;       /* disc behind the hero illustration */
		--code-bg: #f6f8fb;
		--code-border: #e3e6ec;
		--font-mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas,
			'Liberation Mono', monospace;
		/* layout: one container width, one gutter, one tile shape for every page */
		--container-width: 76rem;
		--container-padding: clamp(16px, 4vw, 40px);
		--gap: 1rem;
		--radius: 1.5rem;
		--radius-inner: 1rem;
		--pad: clamp(1.25rem, 3vw, 2.25rem);
	}

	[data-theme="dark"] {
		--primary-bg: #0c0e13;
		--secondary-bg: #171a22;
		--surface-2: #20242e;
		--text-color: #c3c8d4;
		--heading-color: #f3f5f9;
		--muted-color: #8a92a2;
		--accent-color: #6db3f7;
		--accent-fill: #6db3f7;
		--accent-fill-hover: #8cc4fa;
		--accent-soft: #1a2c40;
		--on-accent: #06203a;
		--header-bg: #171a22;
		--border-color: #2a2f3b;
		--shadow-color: rgba(0, 0, 0, 0.4);
		--hero-bg: #0c0e13;
		--avatar-bg: #cfe2f6;
		--code-bg: #12151c;
		--code-border: #2a2f3b;
	}

	/* Shiki emits both themes as --shiki-light / --shiki-dark custom properties
	   (defaultColor: false in astro.config.mjs). Pick one by the site's theme
	   attribute so highlighting follows the toggle, not the OS setting. */
	:root .astro-code,
	:root .astro-code span {
		color: var(--shiki-light);
		font-style: var(--shiki-light-font-style);
		font-weight: var(--shiki-light-font-weight);
		text-decoration: var(--shiki-light-text-decoration);
	}

	[data-theme="dark"] .astro-code,
	[data-theme="dark"] .astro-code span {
		color: var(--shiki-dark);
		font-style: var(--shiki-dark-font-style);
		font-weight: var(--shiki-dark-font-weight);
		text-decoration: var(--shiki-dark-text-decoration);
	}

	/* Drop each theme's own background: code sits on our surface, not on
	   GitHub grey in light mode or Night Owl's near-black in dark. */
	pre.astro-code {
		background-color: var(--code-bg) !important;
		border: 1px solid var(--code-border);
		border-radius: 10px;
		padding: 1rem 1.15rem;
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		line-height: 1.6;
		tab-size: 2;
		-moz-tab-size: 2;
	}

	pre.astro-code code {
		background: none;
		border: none;
		padding: 0;
		font-family: inherit;
		font-size: inherit;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: 'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--text-color);
		background-color: var(--primary-bg);
		-webkit-font-smoothing: antialiased;
		overflow-wrap: break-word;
	}

	/* The one page frame: header, home grid and every inner page share it. */
	.container {
		width: 100%;
		max-width: var(--container-width);
		margin: auto;
		padding: 0 var(--container-padding);
	}

	h1, h2, h3 {
		color: var(--heading-color);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.2;
		margin-bottom: 0.75em;
		text-wrap: balance;
	}

	h1 { font-size: clamp(1.9rem, 6vw, 2.8rem); letter-spacing: -0.03em; line-height: 1.1; }
	h2 { font-size: 1.5rem; }
	h3 { font-size: 1.2rem; font-weight: 700; }

	p {
		margin-bottom: 1em;
	}

	img {
		max-width: 100%;
	}

	a {
		color: var(--accent-color);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	a:hover {
		color: var(--heading-color);
	}

	:focus-visible {
		outline: 2px solid var(--accent-color);
		outline-offset: 2px;
	}

	.site-header {
		padding-top: 1rem;
	}

	.site-header-content {
		display: flex;
		align-items: center;
		gap: 1rem;
		background-color: var(--header-bg);
		border-radius: 999px;
		padding: 0.4rem 0.4rem 0.4rem 0.5rem;
	}

	.header-brand {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.header-avatar {
		display: block;
		height: 2.25rem;
		width: 2.25rem;
		border-radius: 50%;
		object-fit: cover;
		flex: none;
	}

	.header-site-title {
		font-weight: 700;
		color: var(--heading-color);
		white-space: nowrap;
	}

	.main-nav {
		display: flex;
		gap: 0.15rem;
		align-items: center;
		margin-left: auto;
	}

	.nav-link {
		color: var(--muted-color);
		font-size: 0.9rem;
		font-weight: 600;
		padding: 0.45rem 0.8rem;
		border-radius: 999px;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.nav-link:hover {
		color: var(--heading-color);
	}

	.nav-link-active,
	.nav-link-active:hover {
		background-color: var(--heading-color);
		color: var(--primary-bg);
	}

	/* Every page is a stack of tiles inside .container, one --gap apart. */
	.section {
		padding-top: var(--gap);
	}

	.content-panel {
		background-color: var(--secondary-bg);
		border-radius: var(--radius);
		padding: var(--pad);
	}

	.page-header {
		margin-bottom: 2rem;
	}

	.page-header h1 {
		margin-bottom: 0.5rem;
	}

	.page-header p {
		color: var(--muted-color);
		margin-bottom: 0;
	}

	.footer {
		text-align: center;
		padding: 2.5rem 0;
		color: var(--muted-color);
		font-size: 0.875rem;
	}

	.footer p { margin-bottom: 0; }

	/* Pill buttons and links */
	.pill-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.75rem;
		align-items: center;
	}

	.pill {
		display: inline-block;
		border-radius: 999px;
		padding: 0.6rem 1.1rem;
		font-weight: 700;
		font-size: 0.92rem;
		line-height: 1.4;
		background-color: var(--surface-2);
		color: var(--heading-color);
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.pill:hover {
		background-color: var(--accent-soft);
		color: var(--heading-color);
	}

	.pill-primary {
		background-color: var(--accent-fill);
		color: var(--on-accent);
	}

	.pill-primary:hover {
		background-color: var(--accent-fill-hover);
		color: var(--on-accent);
	}

	/* Theme Toggle Styles */
	.theme-toggle {
		background: var(--surface-2);
		border: 0;
		border-radius: 50%;
		width: 2.25rem;
		height: 2.25rem;
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: background-color 0.2s ease, color 0.2s ease;
		color: var(--text-color);
		padding: 0;
	}

	.theme-toggle:hover {
		background-color: var(--accent-soft);
		color: var(--accent-color);
	}

	.theme-toggle-icon {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.theme-toggle-icon svg {
		width: 18px;
		height: 18px;
	}

	/* Shared Blog Styles */
	.blog-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		align-items: center;
		color: var(--muted-color);
		font-size: 0.9rem;
	}

	.blog-tags {
		display: flex;
		gap: 0.35rem;
		flex-wrap: wrap;
	}

	.tag {
		background-color: var(--surface-2);
		color: var(--muted-color);
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 600;
	}

	.back-link {
		color: var(--muted-color);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.back-link:hover {
		color: var(--accent-color);
	}

	/* Post rows: date on the left, title and excerpt on the right */
	.post-rows {
		list-style: none;
		display: grid;
		gap: 0.25rem;
	}

	.post-row a {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		gap: 0.25rem 1rem;
		padding: 0.7rem 0.8rem;
		margin-inline: -0.8rem;
		border-radius: 0.75rem;
		color: inherit;
		transition: background-color 0.2s ease;
	}

	.post-row a:hover {
		background-color: var(--surface-2);
	}

	.post-row time {
		color: var(--muted-color);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		padding-top: 0.15em;
	}

	.post-row-title {
		display: block;
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.35;
		color: var(--heading-color);
		transition: color 0.2s ease;
	}

	.post-row a:hover .post-row-title {
		color: var(--accent-color);
	}

	.post-row-excerpt {
		display: block;
		color: var(--muted-color);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-top: 0.25rem;
	}

	.post-row .blog-tags {
		margin-top: 0.5rem;
	}

	/* Fix for markdown callout boxes */
	[data-theme="dark"] div[style*="background: #f8f9fa"],
	[data-theme="dark"] div[style*="background:#f8f9fa"] {
		background-color: var(--secondary-bg) !important;
		border-color: var(--border-color) !important;
	}
	[data-theme="dark"] div[style*="background: #f8f9fa"] a,
	[data-theme="dark"] div[style*="background:#f8f9fa"] a {
		color: var(--accent-color) !important;
	}
	[data-theme="dark"] div[style*="background: #f8f9fa"] p,
	[data-theme="dark"] div[style*="background:#f8f9fa"] p {
		color: var(--text-color) !important;
	}

	@media (max-width: 560px) {
		.header-site-title {
			display: none;
		}

		.site-header-content {
			gap: 0.25rem;
		}

		.nav-link {
			padding: 0.45rem 0.6rem;
			font-size: 0.85rem;
		}

		.post-row a {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		* {
			transition: none !important;
		}
	}
</style>
